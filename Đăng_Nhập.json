	"item": [
		{
			"name": "API đăng ký tài khoản",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var timestamp = Date.now().toString().slice(-6);",
							"var randomEmail = 'user_' + timestamp + '@gmail.com';",
							"var randomPhone = '098' + Date.now().toString().slice(-7);",
							"pm.variables.set('reg_email', randomEmail);",
							"pm.variables.set('reg_phone', randomPhone);"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code là 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"ApiResponse chuẩn\", function () {",
							"    var res = pm.response.json();",
							"    pm.expect(res.success).to.eql(true);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"fullName\": \"Nguyễn Văn Khách Hàng\",\n  \"email\": \"{{reg_email}}\",\n  \"password\": \"password123\",\n  \"phone\": \"{{reg_phone}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"register"
					]
				}
			},
			"response": []
		},
